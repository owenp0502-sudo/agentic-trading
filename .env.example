# Copy to .env and fill in. NEVER commit the real .env.

# --- Alpaca (data + paper trading account) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# "paper" (default, safe) or "live" — controls which balance the 10% cap reads
ALPACA_PAPER=paper
# Optional static fallback balance if the Alpaca account API is unreachable
ACCOUNT_BALANCE=

# --- Gemini (AI Studio or Vertex express key starting with "AQ.") ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Discord ---
DISCORD_WEBHOOK_URL=
# NUMERIC user id (Developer Mode → Copy User ID), not the username
DISCORD_USER_ID=

# --- Execution bridge ---
RENDER_WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_PASSPHRASE=

# --- Robinhood MCP ---
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# Optional JSON of auth headers, e.g. {"Authorization": "Bearer ..."}
ROBINHOOD_MCP_HEADERS=
