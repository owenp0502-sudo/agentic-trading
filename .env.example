# Copy to .env and fill in. NEVER commit the real .env.

# --- Alpaca (data + paper trading account) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# "paper" (default, safe) or "live" — controls which balance the 10% cap reads
ALPACA_PAPER=paper
# Optional static fallback balance if the Alpaca account API is unreachable
ACCOUNT_BALANCE=

# --- Gemini ---
# Works with AI Studio (AIza...) and Vertex express (AQ...) keys — both route
# through the Developer API endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Discord ---
DISCORD_WEBHOOK_URL=
# NUMERIC user id (Developer Mode → Copy User ID), not the username
DISCORD_USER_ID=

# --- Execution bridge ---
RENDER_WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_PASSPHRASE=

# --- Robinhood MCP (official Agentic Trading) ---
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# One-time bootstrap: run `python robinhood_auth.py` locally (browser consent,
# desktop required). Then paste the printed token JSON here for Render.
ROBINHOOD_TOKEN_STORE_JSON=
# Optional override of the local token file path
# (default ~/.tjr_bot/robinhood_tokens.json)
ROBINHOOD_TOKEN_STORE=
